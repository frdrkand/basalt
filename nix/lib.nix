# Basalt for a Nix-built host: builders that put Basalt's files and a host's
# settings together in the store, and the checks that verify the result.
#
# Every builder takes `pkgs` (the host's, so nothing here pins a nixpkgs of its
# own) and returns a derivation. None of them wraps or installs anything: how
# the host hands these to Hyprland, quickshell, hyprlock and the rest is the
# host's business.
#
#   basalt = inputs.basalt.lib;
#   hyprlandDir   = basalt.hyprlandConfig   { inherit pkgs; settings = { ... }; };
#   quickshellDir = basalt.quickshellConfig { inherit pkgs; settings = { ... }; };
#   # Hyprland --config ${hyprlandDir}/hyprland.lua; quickshell --path ${quickshellDir}
{ lib }:
let
  theme = lib.importJSON ../theme.json;
  baseNames = lib.attrNames theme.palette;

  # The settings a host gives the shell, as QML property assignments. Values go
  # in as JSON wrapped in parentheses: a bare `{` would start an object
  # declaration, not a JS object.
  qmlAssignments =
    settings:
    lib.concatStrings (lib.mapAttrsToList (n: v: "  ${n}: (${builtins.toJSON v})\n") settings);
in
rec {
  # Basalt's own palette and fonts (theme.json): the defaults everywhere.
  inherit theme;

  # The source trees, for a host that wants to place them itself.
  hypr = ../hypr;
  quickshell = ../quickshell;
  dunst = ../dunst;

  # `text` with Basalt's colours and font names swapped for a host's. For the
  # files that cannot take a variable (dunst's ini). Simultaneous, so a host
  # colour equal to another default is not swapped twice; the longer font names
  # come first, so "Hack Nerd Font Mono" is not read as "Hack Nerd Font".
  recolor =
    {
      palette ? theme.palette,
      fonts ? theme.fonts,
    }:
    text:
    let
      fontKeys = [
        "mono"
        "glyph"
        "ui"
      ];
    in
    builtins.replaceStrings (
      map (k: theme.palette.${k}) baseNames ++ map (k: theme.fonts.${k}) fontKeys
    ) (map (k: palette.${k}) baseNames ++ map (k: fonts.${k}) fontKeys) text;

  # basalt-screenshot and basalt-dpms, with what they run on their PATH.
  scripts =
    { pkgs }:
    pkgs.symlinkJoin {
      name = "basalt-scripts";
      paths = [
        (pkgs.writeShellApplication {
          name = "basalt-screenshot";
          runtimeInputs = with pkgs; [
            coreutils
            grim
            slurp
            satty
            jq
            hyprland
            wl-clipboard
          ];
          text = builtins.readFile ../bin/basalt-screenshot;
        })
        (pkgs.writeShellApplication {
          name = "basalt-dpms";
          runtimeInputs = with pkgs; [
            hyprland
            procps
            systemd
          ];
          text = builtins.readFile ../bin/basalt-dpms;
        })
      ];
    };

  # The Hyprland config directory: Basalt at basalt/, and a hyprland.lua that
  # calls basalt.setup() with `settings` (the options in hypr/config.lua, as
  # Nix values) and then runs `extraConfig`, Lua of the host's own.
  # Hyprland is pointed at ${result}/hyprland.lua.
  hyprlandConfig =
    {
      pkgs,
      settings ? { },
      extraConfig ? "",
    }:
    pkgs.runCommand "basalt-hyprland-config"
      {
        luaConfig = ''
          -- GENERATED by Basalt's nix/lib.nix (hyprlandConfig).
          require("basalt").setup(${lib.generators.toLua { } settings})
        ''
        + lib.optionalString (extraConfig != "") "\n${extraConfig}";
        passAsFile = [ "luaConfig" ];
      }
      ''
        mkdir -p $out
        cp -r ${../hypr} $out/basalt
        cp "$luaConfigPath" $out/hyprland.lua
      '';

  # The quickshell config directory: Basalt at basalt/, the host's shell.qml,
  # and a Host.qml setting `settings` (HostConfig.qml's properties, as Nix
  # values). A host that needs more than values (a Component in barItems, an
  # overridden function) passes its own `host` file instead, and any further
  # files of its own in `extraFiles` (name -> path), placed beside shell.qml.
  # quickshell is pointed at the result with --path.
  quickshellConfig =
    {
      pkgs,
      settings ? { },
      host ? null,
      shell ? ../examples/quickshell/shell.qml,
      extraFiles ? { },
    }:
    let
      hostFile =
        if host != null then
          host
        else
          pkgs.writeText "Host.qml" ''
            pragma Singleton

            import qs.basalt

            // GENERATED by Basalt's nix/lib.nix (quickshellConfig).
            HostConfig {
            ${qmlAssignments settings}}
          '';
    in
    pkgs.runCommand "basalt-quickshell-config" { } ''
      mkdir -p $out
      cp -r ${../quickshell} $out/basalt
      cp ${shell} $out/shell.qml
      cp ${hostFile} $out/Host.qml
      ${lib.concatStrings (lib.mapAttrsToList (n: p: "cp -r ${p} $out/${n}\n") extraFiles)}
    '';

  # hyprlang variables for a palette and fonts, as hypr/palette.conf has them.
  paletteConf =
    {
      pkgs,
      palette ? theme.palette,
      fonts ? theme.fonts,
    }:
    pkgs.writeText "basalt-palette.conf" (
      lib.concatMapStrings (k: "\$${k} = ${palette.${k}}\n") baseNames
      + ''
        $fontUi = ${fonts.ui}
        $fontMono = ${fonts.mono}
        $fontGlyph = ${fonts.glyph}
      ''
    );

  # A complete hyprlock.conf: the palette, Basalt's look, then `extraConfig`
  # (the background, an auth block).
  hyprlockConf =
    {
      pkgs,
      palette ? theme.palette,
      fonts ? theme.fonts,
      extraConfig ? "",
    }:
    pkgs.writeText "hyprlock.conf" ''
      source = ${paletteConf { inherit pkgs palette fonts; }}
      source = ${../hypr/hyprlock.conf}

      ${extraConfig}
    '';

  # A complete hypridle.conf: Basalt's lock path and sleep hook, then
  # `extraConfig` (the listeners).
  hypridleConf =
    {
      pkgs,
      extraConfig ? "",
    }:
    pkgs.writeText "hypridle.conf" ''
      source = ${../hypr/hypridle.conf}

      ${extraConfig}
    '';

  # A complete hyprpaper.conf for one wallpaper on every monitor.
  hyprpaperConf =
    {
      pkgs,
      wallpaper,
    }:
    pkgs.writeText "hyprpaper.conf" ''
      $wallpaper = ${wallpaper}
      source = ${../hypr/hyprpaper.conf}
    '';

  # A complete dunstrc: Basalt's, recoloured, then `extraConfig` (sections
  # named again merge, and the later value wins). For `dunst -config`.
  dunstrc =
    {
      pkgs,
      palette ? theme.palette,
      fonts ? theme.fonts,
      extraConfig ? "",
    }:
    pkgs.writeText "dunstrc" (
      recolor { inherit palette fonts; } (builtins.readFile ../dunst/dunstrc)
      + lib.optionalString (extraConfig != "") "\n${extraConfig}"
    );

  # wallpaper.svg as a PNG in a palette, at a size. Every consumer cover-fits
  # it, so a host renders it at the largest width and height among its
  # monitors and nothing ever scales it up. The SVG keeps its colours behind
  # `var(--wp-bg, …)` and `var(--wp-logo, …)`; only the fallbacks are
  # swapped, and --replace-fail stops a renamed literal quietly rendering the
  # old colours.
  wallpaper =
    {
      pkgs,
      palette ? theme.palette,
      width ? 5120,
      height ? 2880,
    }:
    pkgs.runCommand "basalt-wallpaper.png" { nativeBuildInputs = [ pkgs.librsvg ]; } ''
      cp ${../hypr/wallpaper.svg} wallpaper.svg
      chmod +w wallpaper.svg
      substituteInPlace wallpaper.svg \
        --replace-fail '#${theme.palette.base00}' '#${palette.base00}' \
        --replace-fail '#${theme.palette.base03}' '#${palette.base03}'
      rsvg-convert --width ${toString width} --height ${toString height} \
        --format png --output "$out" wallpaper.svg
    '';

  # ---- checks ----

  # `Hyprland --verify-config` on a hyprlandConfig result. A broken config is a
  # session that falls over at login with no way back but a TTY.
  verifyHyprland =
    { pkgs, config }:
    pkgs.runCommand "basalt-hyprland-verified" { } ''
      export XDG_RUNTIME_DIR="$PWD/runtime" HOME="$PWD"
      mkdir -p "$XDG_RUNTIME_DIR"
      ${pkgs.hyprland}/bin/Hyprland --verify-config -c ${config}/hyprland.lua 2>&1 | tee result.log
      grep -qx 'config ok' result.log
      cp result.log "$out"
    '';

  # qmllint over a quickshellConfig result. QML is only checked when it runs,
  # and this shell is the bar, the launcher and the power menu.
  #
  # Quickshell resolves `import qs.…` itself; qmllint needs a qmldir per
  # directory to do the same, so a copy gets them (and never ships them).
  #
  # Strict but for three things. Unqualified access to outer ids is QML idiom.
  # PanelWindow and friends report "not creatable", a gap in how Quickshell
  # declares its own types; the other such gaps are silenced line by line in
  # the QML. And qmllint reports some singletons as undeclared in a qmldir that
  # declares them, so that one message is dropped and every other fails.
  lintQuickshell =
    {
      pkgs,
      config,
      quickshell ? pkgs.quickshell,
    }:
    let
      settings = pkgs.writeText "qmllint.ini" ''
        [General]
        DisableDefaultImports=false

        [Warnings]
        UnqualifiedAccess=disable
        UnusedImports=disable
        UncreatableType=disable
      '';
    in
    pkgs.runCommand "basalt-quickshell-linted" { nativeBuildInputs = [ pkgs.qt6.qtdeclarative ]; } ''
      mkdir -p lint
      cp -rL ${config} lint/qs
      chmod -R u+w lint
      cp ${settings} lint/qs/.qmllint.ini
      find lint/qs -type d | while read -r dir; do
        rel=''${dir#lint/}
        echo "module ''${rel//\//.}" > "$dir/qmldir"
        for f in "$dir"/*.qml; do
          [ -e "$f" ] || continue
          name=$(basename "$f" .qml)
          if grep -q '^pragma Singleton' "$f"; then
            echo "singleton $name 1.0 $name.qml" >> "$dir/qmldir"
          else
            echo "$name 1.0 $name.qml" >> "$dir/qmldir"
          fi
        done
      done
      qmllint \
        -I lint \
        -I ${pkgs.qt6.qtdeclarative}/lib/qt-6/qml \
        -I ${quickshell}/lib/qt-6/qml \
        $(find lint/qs -name '*.qml') > result.log 2>&1 || true
      if grep -E '^(Warning|Error|Info): ' result.log \
          | grep -v 'not declared as singleton in qmldir but using pragma Singleton'; then
        cat result.log
        exit 1
      fi
      cp result.log "$out"
    '';
}
